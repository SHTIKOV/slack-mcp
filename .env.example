# Browser-session credentials (no app, no admin approval).
# How to get them: see README.md -> "Как достать токен и cookie".

# Web-client token from localStorage of the Slack web client (begins with x-o-x-c).
SLACK_XOXC_TOKEN=

# The "d" cookie value (begins with x-o-x-d). Copy it raw (URL-encoded) from
# DevTools -> Application -> Cookies -> https://app.slack.com.
SLACK_XOXD_COOKIE=

# Required. Comma-separated channel ids and/or #names. Fail-closed.
# Example: C01234567,#general,#dev-team
SLACK_ALLOWED_CHANNELS=

# Optional. Defaults to https://slack.com/api
# SLACK_BASE_URL=https://your-workspace.slack.com/api
